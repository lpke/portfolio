# Server-only. Do not prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional. Use a sender address on a Resend-verified domain in production.
# The API route sets the display name from the form submitter.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional. Defaults to SITE.email in src/app/_utils/constants.ts.
CONTACT_TO_EMAIL=
